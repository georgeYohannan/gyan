# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Use the Supabase TEST project until the founder says it is launch time.

# Project URL (Supabase dashboard, Connect). Not secret.
EXPO_PUBLIC_SUPABASE_URL=

# The PUBLIC key only (called "publishable" or "anon"). Never the secret service_role key.
EXPO_PUBLIC_SUPABASE_KEY=

# Optional. Only for the "one user cannot see another user" test (npm test).
# Make 2 FAKE users by hand in the Supabase TEST project dashboard (see docs/testing/prompt-3.md).
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=

# Deepgram key. Used ONLY by you, once, to copy it into the Supabase server secret DEEPGRAM_API_KEY
# (see docs/testing/prompt-5.md). The app never reads it. Never commit the real value.
EXPO_DEEPGRAM_KEY=

# Anthropic (Claude) key. Used ONLY by you, once, to copy it into the Supabase server secret
# ANTHROPIC_API_KEY (see docs/testing/prompt-6.md). The app never reads it. Never commit the real value.
# Keep a DIFFERENT key for test and for live, and set a monthly spend limit in the Claude Console.
EXPO_ANTHROPIC_KEY=

# Sleek (sleek.design) key, for designing screens only. A build-time tool, never read by the app
# and never shipped to users. Get it at https://sleek.design/dashboard/api-keys.
SLEEK_API_KEY=

# The password of the gyan@gyantechai.com mailbox at Hostinger. Recap emails are sent through
# that mailbox. Used ONLY by you, once, to copy it into the Supabase server secret SMTP_PASSWORD
# (see docs/testing/prompt-9.md). The app never reads it, and it is never shipped.
# Never commit the real value.
EXPO_SMTP_PASSWORD=

# Where the web app lives, used for the buttons inside a recap email ("Open this note in gyan"
# and "Turn off recaps") and for the Join button inside an invite email. Copy it into the
# server secret GYAN_APP_URL. The app never reads this.
#
# While you are testing, http://localhost:8081 is fine AS LONG AS you open the emails on the
# same computer that is running the app. "localhost" means "the device I am holding", so a
# link built from it dies on a phone with "site can't be reached". To open emails on your
# phone, use your computer's wifi address instead (ipconfig getifaddr en0), with both devices
# on the same network: http://192.168.1.23:8081
EXPO_GYAN_APP_URL=

# Turns on the builders-only tools in the app: today that is the test-only plan switch on
# Settings > Plan and usage. Set it to exactly 1 while you are testing, and NEVER in a real
# build. Leaving it out, or setting it to anything else, hides the switch.
# The database refuses the switch for anybody who is not a Gyan admin as well, so this is the
# polite half of the rule rather than the whole of it (see docs/testing/prompt-10.md).
EXPO_PUBLIC_GYAN_TEST_TOOLS=

# The meeting-bot service's key. Today that is Recall.ai, in their US EAST region. The name is
# deliberately NOT "RECALL_": swapping to another service (Vexa, Attendee, MeetingBaaS -- see
# docs/decisions/bot-provider.md) then does not change a setting name.
# Used ONLY by you, once, to copy it into the Supabase server secret MEETING_BOT_API_KEY
# (see docs/testing/prompt-14.md). The app never reads it. Never commit the real value.
MEETING_BOT_API_KEY=

# The secret that proves a status event really came from the bot service. In Recall.ai's dashboard
# it is a workspace secret and starts with "whsec_". Copy it into the Supabase server secret
# MEETING_BOT_WEBHOOK_SECRET. Without it every event is refused, and no note ever moves past
# "Joining". The app never reads it. Never commit the real value.
MEETING_BOT_WEBHOOK_SECRET=
